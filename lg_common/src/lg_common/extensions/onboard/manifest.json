{
    "manifest_version": 3,
    "name": "Onboard",
    "version": "2.0",
    "description": "This extension shows and hides the onboard keyboard.",
    "background": {
        "service_worker": "sw.js"
    },
    "action": {
        "default_icon": "onboard.png",
        "default_title": "keyboard"
    },
    "content_scripts": [
        {
            "all_frames": true,
            "js": [
                "apply.js"
            ],
            "matches": [
                "*://*.google.com/maps/*"
            ]
        }
    ],
    "options_ui": {
        "page": "options.html"
    },
    "permissions": [
        "offscreen",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}
