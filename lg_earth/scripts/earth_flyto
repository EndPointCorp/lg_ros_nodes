#!/usr/bin/env python3
"""Request one center-Earth, zero-duration KML FlyTo."""

import argparse
import sys
import time

from lg_earth.tour import build_tour_kml


TOUR_NAME = 'earth-flyto-test'
DEFAULT_FLYTO = '''
<gx:FlyTo xmlns:gx="http://www.google.com/kml/ext/2.2"
           xmlns="http://www.opengis.net/kml/2.2">
  <gx:duration>0</gx:duration>
  <gx:flyToMode>bounce</gx:flyToMode>
  <Camera>
    <longitude>151.2153</longitude>
    <latitude>-33.8568</latitude>
    <altitude>1500</altitude>
    <heading>0</heading>
    <tilt>45</tilt>
    <roll>0</roll>
    <altitudeMode>absolute</altitudeMode>
  </Camera>
</gx:FlyTo>
'''.strip()


def publish_fragment(fragment, timeout):
    """Publish a fragment to the center-only Earth tour node."""
    try:
        import rospy
        from std_msgs.msg import String
    except ImportError:
        # VPLib images expose a rospy-compatible API and generated messages
        # through visionport.vpros; they intentionally contain no ROS install.
        import visionport.vpros as rospy
        from visionport.vpros.models.std_msgs.msg import String

    rospy.init_node('earth_flyto', anonymous=True, disable_signals=True)
    publisher = rospy.Publisher('/earth/query/flyto_tour', String, queue_size=1)

    # ROS can report subscriber connections. VPROS uses MQTT and deliberately
    # does not expose that ROS-specific API, so its publishers are ready after
    # the node has connected to the broker.
    if hasattr(publisher, 'get_num_connections'):
        deadline = time.time() + timeout
        while publisher.get_num_connections() == 0 and time.time() < deadline:
            if rospy.is_shutdown():
                raise RuntimeError('ROS shut down while waiting for Earth tour player')
            rospy.sleep(0.05)
        if publisher.get_num_connections() == 0:
            raise RuntimeError('no Earth tour player after {} seconds'.format(timeout))
    else:
        rospy.sleep(0.25)

    publisher.publish(String(fragment))
    rospy.sleep(0.5)


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description='Wrap and autoplay a KML FlyTo, Camera, or LookAt in Google Earth.'
    )
    parser.add_argument(
        'flyto', nargs='?', default=DEFAULT_FLYTO,
        help='KML fragment, @filename, or - to read from stdin; defaults to a teleport to Sydney.'
    )
    parser.add_argument(
        '--duration', type=float,
        help='override gx:duration in seconds (use 0 for teleport)'
    )
    parser.add_argument(
        '--print-only', action='store_true',
        help='print the generated KML without publishing it'
    )
    parser.add_argument(
        '--timeout', type=float, default=5.0,
        help='seconds to wait for the add-KML ROS subscriber (default: 5)'
    )
    return parser.parse_args(argv)


def read_fragment(argument):
    if argument == '-':
        return sys.stdin.read()
    if argument.startswith('@'):
        with open(argument[1:], 'r') as source:
            return source.read()
    return argument


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        fragment = read_fragment(args.flyto)
        if args.print_only:
            print(build_tour_kml(
                fragment, tour_name=TOUR_NAME,
                duration=0 if args.duration is None else args.duration))
        else:
            if args.duration not in (None, 0):
                raise ValueError('the live Earth tour player currently uses duration 0')
            publish_fragment(fragment, args.timeout)
            print('Requested a center-Earth teleport tour')
    except (IOError, OSError, RuntimeError, ValueError) as exc:
        print('earth_flyto: {}'.format(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
